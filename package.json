{
  "name": "md-template-lint",
  "version": "0.2.2",
  "description": "Lint Markdown files (frontmatter and headings) against Markdown templates.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@12.18.0",
  "bin": {
    "mdtl": "dist/cli.js",
    "md-template-lint": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "LICENSE",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md",
    "README.md",
    "CONTRIBUTING.md",
    "AI_GUIDELINE.md"
  ],
  "author": "Marc CERUTTI",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/m21-cerutti/md-template-lint.git"
  },
  "homepage": "https://github.com/m21-cerutti/md-template-lint#readme",
  "bugs": {
    "url": "https://github.com/m21-cerutti/md-template-lint/issues"
  },
  "scripts": {
    "prepare": "husky",
    "lint": "pnpm run lint:ts && pnpm run lint:md && pnpm run lint:names && pnpm run lint:secrets",
    "lint:ts": "eslint .",
    "lint:md": "markdownlint-cli2 \"**/*.md\"",
    "lint:md:template": "node dist/cli.js",
    "lint:names": "ls-lint",
    "lint:secrets": "secretlint \"**/*\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "tsc -p tsconfig.json",
    "check:parser": "tsx scripts/check-parser.ts",
    "check:rules": "vitest run tests/consistency",
    "check:syntax-doc": "tsx scripts/syntax-doc/generate.ts check",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run --passWithNoTests",
    "coverage": "vitest run --coverage",
    "prepack": "pnpm run build",
    "smoke:pack": "tsx scripts/smoke-pack.ts",
    "gen:parser": "tsx scripts/gen-parser.ts",
    "gen:syntax-doc": "tsx scripts/syntax-doc/generate.ts write",
    "new:rule": "tsx scripts/new-rule.ts"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/types": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@ls-lint/ls-lint": "^2.3.2",
    "@secretlint/secretlint-rule-preset-recommend": "^13.1.0",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.5",
    "antlr-ng": "1.0.10",
    "eslint": "^10.13.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^17.6.0",
    "markdownlint-cli2": "^0.24.0",
    "prettier": "^3.9.10",
    "secretlint": "^13.1.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "antlr4ng": "3.0.16",
    "yaml": "2.9.1"
  }
}
