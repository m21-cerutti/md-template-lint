{
  "name": "md-template-lint",
  "version": "0.2.0",
  "description": "Lint Markdown files (frontmatter and headings) against Markdown templates.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@11.16.0",
  "bin": {
    "md-template-lint": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "LICENSE",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md",
    "README.md"
  ],
  "author": "Marc CERUTTI",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/m21-cerutti/markdown-template-linter.git"
  },
  "homepage": "https://github.com/m21-cerutti/markdown-template-linter#readme",
  "bugs": {
    "url": "https://github.com/m21-cerutti/markdown-template-linter/issues"
  },
  "scripts": {
    "gen:parser": "tsx scripts/gen-parser.ts",
    "check:parser": "tsx scripts/check-parser.ts",
    "check:rules": "vitest run tests/consistency",
    "new:rule": "tsx scripts/new-rule.ts",
    "gen:syntax-doc": "tsx scripts/syntax-doc/generate.ts write",
    "check:syntax-doc": "tsx scripts/syntax-doc/generate.ts check",
    "typecheck": "tsc -p tsconfig.test.json && tsc -p tsconfig.scripts.json",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepack": "pnpm run build",
    "smoke:pack": "tsx scripts/smoke-pack.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.5",
    "antlr-ng": "1.0.10",
    "eslint": "^10.13.0",
    "jiti": "^2.7.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "antlr4ng": "3.0.16",
    "yaml": "2.9.1"
  }
}
