[
  {
    "path": "template.md",
    "status": "ok",
    "filenameCase": null,
    "uniqueHeadingNames": false,
    "frontmatterOptional": false,
    "fields": [{ "name": "title", "type": "string", "rules": ["presence:required"] }],
    "headings": [
      { "level": 1, "text": "Changelog", "rules": ["presence:required"] },
      {
        "level": 2,
        "text": "Release",
        "rules": ["presence:required", "pattern:\"[{semver}] - {date}\"", "repeat-rules:same-level"]
      },
      {
        "level": 3,
        "text": "Step",
        "rules": [
          "presence:required",
          "pattern:\"Step {digits}\"",
          "repeat-rules:same-level",
          "repeat-rules:same-level:min:2",
          "repeat-rules:same-level:max:5",
          "content:non-empty",
          "content:list"
        ]
      }
    ],
    "diagnostics": []
  }
]
